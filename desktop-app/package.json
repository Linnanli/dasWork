{
  "name": "desktop-app",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run && npm run test:release-contract",
    "test:unit": "vitest run",
    "test:release-contract": "node --test scripts/tests/release-workflow.node-test.mjs scripts/tests/release-artifacts.node-test.mjs",
    "test:plan-coverage": "npm run test:plan-coverage:validator && node scripts/test-plan-coverage.mjs",
    "test:plan-coverage:validator": "node --test scripts/tests/verify-test-plan-coverage.node-test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:conversation-performance": "npm run build && playwright test tests/e2e/conversation-stream-performance.e2e.ts --workers=1",
    "test:e2e:review-performance": "npm run build && playwright test tests/e2e/local-git-review-performance.e2e.ts --workers=1",
    "test:e2e:stability": "npm run build && playwright test --grep '(@terminal-failure|@recovery|@approval-retry)' --repeat-each=10 --workers=1 --retries=0",
    "test:e2e:dev-llm": "node scripts/run-dev-llm-smoke.mjs",
    "test:e2e:release-llm": "node scripts/run-release-llm-smoke.mjs",
    "test:e2e:installer": "node scripts/run-installer-local-media-smoke.mjs",
    "verify:pdf-worker-bundle": "node scripts/verify-pdf-worker-bundle.mjs",
    "verify:review-diff-worker-bundle": "node scripts/verify-review-diff-worker-bundle.mjs",
    "test:e2e:packaged": "node scripts/run-packaged-local-media-smoke.mjs",
    "pretest": "npm run build:codex-asp-provider",
    "pretypecheck": "npm run build:codex-asp-provider",
    "prestart": "npm run build:codex-asp-provider",
    "predev": "npm run build:codex-asp-provider",
    "build:codex-asp-provider": "node scripts/build-codex-asp-provider.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "reference:chatgpt": "node scripts/extract-chatgpt-reference.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@janole/ai-sdk-provider-codex-asp": "file:vendors/ai-sdk-provider-codex-asp",
    "@pierre/diffs": "1.2.12",
    "@pierre/trees": "1.0.0-beta.6",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "ai": "^6.0.213",
    "next-themes": "^0.4.6",
    "node-pty": "1.1.0",
    "pdfjs-dist": "5.4.296",
    "react-pdf": "10.4.1",
    "smol-toml": "^1.5.2",
    "sonner": "^2.0.8",
    "zod": "^4.1.8",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@assistant-ui/core": "0.2.19",
    "@assistant-ui/store": "0.2.19",
    "@assistant-ui/tap": "0.9.3",
    "@shikijs/transformers": "3.23.0",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "^3.0.215",
    "@assistant-ui/react": "0.14.24",
    "@assistant-ui/react-ai-sdk": "^1.3.38",
    "@assistant-ui/react-lexical": "0.2.3",
    "@assistant-ui/react-streamdown": "^0.3.4",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@lexical/react": "0.45.0",
    "@lexical/utils": "0.45.0",
    "@openai/codex": "0.148.0-alpha.21",
    "@playwright/test": "^1.61.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^8.0.4",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.1.1",
    "katex": "^0.17.0",
    "lexical": "0.45.0",
    "lucide-react": "^1.18.0",
    "parse-diff": "^0.12.0",
    "prettier": "^3.7.4",
    "radix-ui": "^1.5.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "shadcn": "^4.11.0",
    "ssh2": "^1.17.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "tw-glass": "^0.0.5",
    "tw-shimmer": "^0.4.11",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.8"
  }
}

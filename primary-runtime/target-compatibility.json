{
  "schemaVersion": "dascowork-primary-runtime-target-compatibility.v1",
  "targets": {
    "darwin-x64": {
      "minimumOs": "macOS 12",
      "cpu": "x64",
      "requirements": [
        "code-signature",
        "notarization-ticket",
        "font-fallback-validation"
      ]
    },
    "darwin-arm64": {
      "minimumOs": "macOS 12",
      "cpu": "arm64",
      "requirements": [
        "code-signature",
        "notarization-ticket",
        "font-fallback-validation"
      ]
    },
    "win32-x64": {
      "minimumOs": "Windows 10 22H2",
      "cpu": "x64",
      "requirements": [
        "authenticode",
        "smartscreen-policy",
        "font-fallback-validation"
      ]
    },
    "linux-x64": {
      "minimumOs": "glibc 2.28 distribution baseline",
      "cpu": "x64",
      "requirements": [
        "elf-interpreter",
        "glibc-ceiling",
        "font-fallback-validation"
      ]
    }
  }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dascowork.local/schemas/primary-runtime-inputs.v1.json",
  "title": "dasCowork Primary Runtime input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "sourceLockSha256",
    "toolchainsLockSha256",
    "builder",
    "artifacts",
    "patches",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "dascowork-primary-runtime-inputs.v1" },
    "target": { "enum": ["darwin-x64", "darwin-arm64", "win32-x64", "linux-x64"] },
    "sourceLockSha256": { "pattern": "^[a-f0-9]{64}$" },
    "toolchainsLockSha256": { "pattern": "^[a-f0-9]{64}$" },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "runner",
        "identity",
        "observedImage",
        "observedImageSha256",
        "tools"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 },
        "observedImage": { "type": "string", "minLength": 1 },
        "observedImageSha256": { "pattern": "^[a-f0-9]{64}$" },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "versionSha256"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "versionSha256": { "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "sha256", "license", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sha256": { "pattern": "^[a-f0-9]{64}$" },
          "license": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)" },
          "sha256": { "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)" },
          "mode": { "enum": ["100644", "100755"] },
          "sha256": { "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dasCowork Primary Runtime bundle manifest",
  "type": "object",
  "required": [
    "bundleFormatVersion",
    "bundleVersion",
    "target",
    "node",
    "nodePackages"
  ],
  "properties": {
    "bundleFormatVersion": { "const": 2 },
    "bundleVersion": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["platform", "arch"],
      "properties": {
        "platform": { "enum": ["darwin", "win32", "linux"] },
        "arch": { "enum": ["x64", "arm64"] }
      }
    },
    "node": {
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "type": "string" } }
    },
    "nodePackages": { "type": "array", "minItems": 1 },
    "bundledPlugins": { "type": "array" },
    "bundledSkills": { "type": "array" },
    "skillsToRemove": { "type": "array" }
  }
}
